// use prisma-8

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Profile {
  id String @id @default(uuid())
  name String
  description String
  skills Skill[]
  experience Experience[]
  projects Project[]
}

model Experience {
  id String @id @default(uuid())
  achievement String[]
  company String
  startDate DateTime
  endDate DateTime
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Skill {
  id String @id @default(uuid())
  name String
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Project {
  id String @id @default(uuid())
  name String
  description String
  stack     String[]
  link      String?
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}